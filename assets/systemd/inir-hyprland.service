[Unit]
Description=iNiR shell (Hyprland)
# Started by the session bootstrap in ~/.config/hypr/inir/autostart.lua
# (hyprland.start): it first publishes WAYLAND_DISPLAY, XDG_SESSION_TYPE,
# XDG_CURRENT_DESKTOP and HYPRLAND_INSTANCE_SIGNATURE into the systemd user
# manager and the D-Bus activation environment, then starts this service.
# This is the single authoritative launch path — do NOT wire this unit into
# compositor wants directories or graphical-session.target.wants: that target
# refuses manual starts (RefuseManualStart=yes) and is never active on plain
# Hyprland sessions, and a wants link would also fire under other DEs.
# Only run inside a real Hyprland session: skips cleanly (no error) when
# started from another session or a TTY without a Hyprland environment.
ConditionEnvironment=HYPRLAND_INSTANCE_SIGNATURE
PartOf=graphical-session.target
After=graphical-session.target
Before=xdg-desktop-autostart.target
# Rate-limit restarts: max 3 attempts in 30 seconds, then stop trying.
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=dbus
BusName=org.kde.StatusNotifierWatcher

# Fail fast with an actionable diagnostic instead of Quickshell's
# "Failed to create wl_display" FATAL crash: the session bootstrap must have
# published the Wayland environment before this unit starts. A transient
# failure (compositor restarting) resolves via Restart=on-failure below.
ExecStartPre=/bin/sh -c 'test -n "$WAYLAND_DISPLAY" || { echo "inir-hyprland: WAYLAND_DISPLAY is not set — Hyprland session environment not imported yet (bootstrap in autostart.lua missing?)"; exit 1; }; test -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" || { echo "inir-hyprland: Wayland socket $XDG_RUNTIME_DIR/$WAYLAND_DISPLAY does not exist — compositor not ready"; exit 1; }'

# Pre-seed stable environment so the bash wrapper skips detection at boot.
# QT_SCALE_FACTOR must be 1 — shell scaling is handled in QML.
# QT_SCALE_FACTOR_ROUNDING_POLICY=RoundPreferFloor prevents blurry rendering
# when compositor uses fractional scaling (1.25 etc) — Qt rounds to integer.
# QT_LOGGING_RULES suppresses noisy Qt/KF warnings.
Environment=QT_SCALE_FACTOR=1
Environment=QT_SCALE_FACTOR_ROUNDING_POLICY=RoundPreferFloor
Environment=QT_LOGGING_RULES=quickshell.dbus.properties=false;qt.qml.settings.warning=false;qt.core.qsettings.warning=false;kf.xmlgui=false;kf.coreaddons=false;kf.config.core=false;kf.iconthemes=false;qt.qpa.wayland.textinput.warning=false

ExecStart=/usr/bin/inir run --session
SuccessExitStatus=143

# process mode: only SIGTERM the main PID so user-spawned apps (terminals,
# media players, etc.) survive shell restarts. Orphan shell helpers are
# cleaned by ExecStopPost instead.
KillMode=process
KillSignal=SIGTERM

# on-failure: restart on both signals (SIGSEGV, SIGABRT) AND non-zero exit
# codes (QML errors, unhandled exceptions). Clean SIGTERM shutdown is already
# excluded via SuccessExitStatus=143. The rate limiter (3 in 30s) prevents
# infinite crash loops — after 3 rapid failures systemd gives up.
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

# Disable coredumps and QS crash reports. Unpatched Quickshell segfaults
# on hot-reload (use-after-free in IpcHandlerRegistry — extensions freed
# before root destruction). Each coredump is 45-90 MB and QS crash reports
# accumulate in ~/.cache/quickshell/crashes/. See patches/quickshell/ for
# the upstream fix.
LimitCORE=0
Environment=QS_DISABLE_CRASH_HANDLER=1

# Clean up stale Quickshell runtime entries (by-pid, by-id) left behind
# after crashes. KillMode=process only kills the main PID, so orphaned
# QS child processes and their runtime artifacts accumulate over time.
ExecStopPost=-/usr/bin/inir cleanup-orphans

# Boost I/O priority so QML/Qt library loading wins over background services
# during cold-boot I/O contention (portals, tray apps, etc.)
IOSchedulingPriority=2

# No [Install] section — this unit is started by the Hyprland session
# bootstrap in defaults/hypr/inir/autostart.lua (hyprland.start), which
# publishes the Wayland session environment first. It must not be enabled
# via wants links: graphical-session.target never activates on plain
# Hyprland sessions, and a link there would also fire under other DEs.
