pkgname=inir-core
pkgver=1.0
pkgrel=1
pkgdesc='iNiR - core dependency bundle'
arch=(any)
license=('GPL-3.0-only')
depends=(
  # Hyprland compositor
  hyprland
  
  # Wallpaper daemon
  awww
  
  # Basic utilities
  coreutils
  cliphist
  curl
  ripgrep
  jq
  python
  xdg-user-dirs
  xdg-utils
  rsync
  git
  wl-clipboard
  libnotify
  pacman-contrib  # checkupdates for update notifications
  wlsunset
  
  # XDG Portals for Hyprland
  xdg-desktop-portal
  xdg-desktop-portal-hyprland
  xdg-desktop-portal-kde
  
  # Polkit, for the shell's own authentication dialogs
  polkit
  
  # Network
  networkmanager
  gnome-keyring
  
  # File manager
  dolphin
  
  # Terminal - kitty is default, configurable in Settings
  kitty
  
  # Shell - fish is required for scripts
  fish
  
  # TUI for setup script
  gum
  # X11 compatibility
  xwayland-satellite
  
)
